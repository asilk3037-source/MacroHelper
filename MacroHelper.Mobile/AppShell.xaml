<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="MacroHelper.Mobile.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:MacroHelper.Mobile.Pages"
       Shell.FlyoutBehavior="Disabled"
       BackgroundColor="#1a1a2e">

    <TabBar>
        <ShellContent Title="Macros" Icon="macro_icon.png" Route="macros"
                      ContentTemplate="{DataTemplate pages:MacrosPage}"/>
        <ShellContent Title="Categorias" Icon="category_icon.png" Route="categorias"
                      ContentTemplate="{DataTemplate pages:CategoriasPage}"/>
        <ShellContent Title="Relatório" Icon="chart_icon.png" Route="relatorio"
                      ContentTemplate="{DataTemplate pages:RelatorioPage}"/>
        <ShellContent Title="Configurações" Icon="settings_icon.png" Route="configuracoes"
                      ContentTemplate="{DataTemplate pages:ConfigPage}"/>
    </TabBar>
</Shell>
