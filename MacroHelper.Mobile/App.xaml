<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:MacroHelper.Mobile.Converters"
             x:Class="MacroHelper.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NotEmptyConverter      x:Key="NotEmptyConverter"/>
            <conv:InvertBoolConverter    x:Key="InvertBoolConverter"/>
            <conv:LoadingConverter       x:Key="LoadingConverter"/>
            <conv:PrimeiraLetraConverter x:Key="PrimeiraLetraConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
