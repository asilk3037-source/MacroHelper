<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- SK MacroHelper Brand Colors -->
    <Color x:Key="Primary">#6C5CE7</Color>
    <Color x:Key="PrimaryDark">#4A3DB5</Color>
    <Color x:Key="PrimaryLight">#A29BFE</Color>
    <Color x:Key="Accent">#8B5CF6</Color>

    <!-- Backgrounds -->
    <Color x:Key="AppBgLight">#F5F5F0</Color>
    <Color x:Key="AppBgDark">#0F0F14</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#1A1A24</Color>
    <Color x:Key="SidebarDark">#13121E</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#1A1A18</Color>
    <Color x:Key="TextPrimaryDark">#F0EFFA</Color>
    <Color x:Key="TextSecondaryLight">#6B6B66</Color>
    <Color x:Key="TextSecondaryDark">#9896B8</Color>
    <Color x:Key="TextMuted">#8886A8</Color>

    <!-- Status -->
    <Color x:Key="Success">#4ADE80</Color>
    <Color x:Key="Danger">#F87171</Color>
    <Color x:Key="Warning">#FBBF24</Color>
    <Color x:Key="DangerBg">#2A1010</Color>
    <Color x:Key="SuccessBg">#0D2818</Color>

</ResourceDictionary>
