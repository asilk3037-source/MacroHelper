<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MacroHelper.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationId>com.silk.macrohelper</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationTitle>SK MacroHelper</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls"            Version="8.0.21" />
    <PackageReference Include="CommunityToolkit.Mvvm"              Version="8.2.2"  />
    <PackageReference Include="CommunityToolkit.Maui"              Version="7.0.1"  />
  </ItemGroup>

  <!-- App icon -->
  <ItemGroup>
    <MauiIcon Include="Resources\Images\appicon.svg"
              ForegroundFile="Resources\Images\appiconfg.svg"
              Color="#6C5CE7"/>
  </ItemGroup>

  <!-- Splash screen -->
  <ItemGroup>
    <MauiSplashScreen Include="Resources\Images\splash.svg" Color="#1a1a2e" BaseSize="128,128"/>
  </ItemGroup>
</Project>
