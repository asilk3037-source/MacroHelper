<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MacroHelper.Mobile.Pages.MacrosPage"
             Title="Macros" BackgroundColor="{AppThemeBinding Light=#f5f5f0, Dark=#0f0f14}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,0,16,0">
            <Border BackgroundColor="#6C5CE7" WidthRequest="32" HeightRequest="32" Margin="0,0,10,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
                <Label Text="SK" FontSize="13" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <Label Grid.Column="1" Text="SK MacroHelper" FontSize="16" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"
                   VerticalOptions="Center"/>
            <Button Grid.Column="2" Text="+ Nova" Command="{Binding NovaMacroCommand}"
                    BackgroundColor="#6C5CE7" TextColor="White" CornerRadius="8"
                    FontSize="12" Padding="12,6" HeightRequest="34"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Busca -->
        <Border Grid.Row="0" Margin="16,12"
                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
            <Grid ColumnDefinitions="*" Padding="12,0">
                <SearchBar Grid.Column="0" Text="{Binding Busca}"
                           Placeholder="Buscar macros..."
                           PlaceholderColor="{AppThemeBinding Light=#9b9b96, Dark=#5e5c7a}"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border Grid.Row="1" Margin="16,0,16,8"
                BackgroundColor="#0d2818" Stroke="#1a7a4a" StrokeThickness="1"
                Padding="14,10" IsVisible="{Binding Mensagem, Converter={StaticResource NotEmptyConverter}}">
            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
            <Label Text="{Binding Mensagem}" TextColor="#4ade80" FontSize="13"/>
        </Border>

        <!-- Offline banner -->
        <Border Grid.Row="2" Margin="16,0,16,8"
                BackgroundColor="#2a1f0d" Stroke="#7a5a1a" StrokeThickness="1"
                Padding="14,8" IsVisible="{Binding ModoOffline}">
            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
            <Label Text="Sem conexão — exibindo macros salvas no dispositivo" TextColor="#facc15" FontSize="12"/>
        </Border>

        <!-- Lista -->
        <RefreshView Grid.Row="3" Command="{Binding AtualizarCommand}"
                     IsRefreshing="{Binding Carregando}">
            <CollectionView ItemsSource="{Binding Macros}" Margin="16,0,16,16">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="40">
                        <Label Text="Nenhuma macro" FontSize="16" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                        <Label Text="Crie sua primeira macro com o botão + Nova"
                               FontSize="13" HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#9b9b96, Dark=#5e5c7a}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                                Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}"
                                StrokeThickness="1" Padding="16,14">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}"
                                                      CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                <!-- Badge atalho + categoria -->
                                <FlexLayout Grid.Row="0" Wrap="Wrap" Direction="Row" Gap="6">
                                    <Border BackgroundColor="#1e1c35" Padding="8,3">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                                        <Label TextColor="#b0a8ff" FontSize="11" FontFamily="Courier New">
                                            <Label.Text>
                                                <MultiBinding StringFormat="/{0}">
                                                    <Binding Path="Atalho"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Border>
                                    <Border BackgroundColor="{AppThemeBinding Light=#f0eee8, Dark=#161622}"
                                            Padding="8,3" IsVisible="{Binding Categoria, Converter={StaticResource NotEmptyConverter}}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                                        <Label Text="{Binding Categoria}" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#6b6b66, Dark=#9896b8}"/>
                                    </Border>
                                </FlexLayout>

                                <!-- Título -->
                                <Label Grid.Row="1" Text="{Binding Titulo}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>

                                <!-- Preview -->
                                <Label Grid.Row="2" Text="{Binding Conteudo}"
                                       FontSize="12" MaxLines="2" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#6b6b66, Dark=#9896b8}"/>

                                <!-- Ações -->
                                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                    <Label Grid.Column="0"
                                           Text="{Binding DataCriacao, StringFormat='Criada em {0:dd/MM/yyyy}'}"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light=#9b9b96, Dark=#5e5c7a}"/>
                                    <Button Grid.Column="1" Text="Copiar"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopiarCommand}"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="#1e1c35" TextColor="#b0a8ff"
                                            FontSize="11" CornerRadius="7" Padding="10,4"
                                            HeightRequest="30" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Text="Excluir"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ExcluirCommand}"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="#2a1010" TextColor="#f87171"
                                            FontSize="13" CornerRadius="7" Padding="8,4"
                                            HeightRequest="30"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
