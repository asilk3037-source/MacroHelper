<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MacroHelper.Mobile.Pages.ConfigPage"
             Title="Configurações"
             BackgroundColor="{AppThemeBinding Light=#f5f5f0, Dark=#0f0f14}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Conta -->
            <Border BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                    Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1" Padding="20,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Conta" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                    <Label Text="{Binding NomeUsuario}" FontSize="16" FontAttributes="Bold"
                           TextColor="#6C5CE7"/>
                    <Label Text="{Binding Email}" FontSize="13"
                           TextColor="{AppThemeBinding Light=#6b6b66, Dark=#9896b8}"/>
                    <Button Text="Sair da conta" Command="{Binding LogoutCommand}"
                            BackgroundColor="#2a1010" TextColor="#f87171"
                            CornerRadius="10" HeightRequest="44"/>
                </VerticalStackLayout>
            </Border>

            <!-- Conexão API -->
            <Border BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                    Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1" Padding="20,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Conexão com a API" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                    <Label Text="URL do servidor onde a API está rodando" FontSize="12"
                           TextColor="{AppThemeBinding Light=#9b9b96, Dark=#5e5c7a}"/>
                    <Border BackgroundColor="{AppThemeBinding Light=#f5f5f0, Dark=#0f0f14}"
                            Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1" Padding="4,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Entry Text="{Binding ApiUrl}"
                               TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"
                               BackgroundColor="Transparent" Placeholder="http://192.168.x.x:5000"
                               PlaceholderColor="{AppThemeBinding Light=#9b9b96, Dark=#5e5c7a}"/>
                    </Border>
                    <Button Text="Salvar e testar conexão" Command="{Binding SalvarUrlCommand}"
                            BackgroundColor="#6C5CE7" TextColor="White"
                            CornerRadius="10" HeightRequest="44" FontAttributes="Bold"/>
                    <Label Text="{Binding StatusConexao}" FontSize="12" HorizontalOptions="Center"
                           TextColor="{Binding StatusCor}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Tema -->
            <Border BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                    Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1" Padding="20,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tema" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Claro"
                                Command="{Binding TemaClaro}"
                                BackgroundColor="{AppThemeBinding Light=#eef0ff, Dark=#1e1c35}"
                                TextColor="{AppThemeBinding Light=#3b31c0, Dark=#b0a8ff}"
                                CornerRadius="10" HeightRequest="44"/>
                        <Button Grid.Column="1" Text="Escuro"
                                Command="{Binding TemaEscuro}"
                                BackgroundColor="{AppThemeBinding Light=#1e1e2a, Dark=#26244a}"
                                TextColor="{AppThemeBinding Light=#f0effa, Dark=#f0effa}"
                                CornerRadius="10" HeightRequest="44"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sobre -->
            <Border BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                    Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}" StrokeThickness="1" Padding="20,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Border BackgroundColor="#6C5CE7" WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Label Text="SK" FontSize="22" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="SK MacroHelper" FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"
                           HorizontalOptions="Center"/>
                    <Label Text="Versão 1.1.0" FontSize="12" TextColor="#8886a8" HorizontalOptions="Center"/>
                    <Label Text="Desenvolvido por Aline Martins · Silk" FontSize="11"
                           TextColor="#6C5CE7" HorizontalOptions="Center" FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
