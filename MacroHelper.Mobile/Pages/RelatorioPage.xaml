<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MacroHelper.Mobile.Pages.RelatorioPage"
             Title="Relatório"
             BackgroundColor="{AppThemeBinding Light=#f5f5f0, Dark=#0f0f14}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <!-- Cards totalizadores -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                        Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}"
                        StrokeThickness="1" Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="HOJE" FontSize="10" FontAttributes="Bold" TextColor="#8886a8"/>
                        <Label Text="{Binding TotalHoje}" FontSize="28" FontAttributes="Bold" TextColor="#6C5CE7"/>
                        <Label Text="macros usadas" FontSize="11" TextColor="#8886a8"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1"
                        BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                        Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}"
                        StrokeThickness="1" Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout>
                        <Label Text="TOTAL" FontSize="10" FontAttributes="Bold" TextColor="#8886a8"/>
                        <Label Text="{Binding Total}" FontSize="28" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                        <Label Text="no período" FontSize="11" TextColor="#8886a8"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Lista de logs -->
            <CollectionView ItemsSource="{Binding Registros}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8">
                        <Label Text="Nenhum uso registrado" FontSize="14" FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#1a1a24}"
                                Stroke="{AppThemeBinding Light=#e0ded8, Dark=#2e2e3e}"
                                StrokeThickness="1" Padding="16,12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding MacroTitulo}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1a1a18, Dark=#f0effa}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding DataUso, StringFormat='{0:dd/MM HH:mm}'}"
                                       FontSize="11" TextColor="#8886a8" VerticalOptions="Center"/>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="11" TextColor="#8886a8" Margin="0,3,0,0">
                                    <Label.Text>
                                        <MultiBinding StringFormat="/{0}  ·  {1}">
                                            <Binding Path="MacroAtalho"/>
                                            <Binding Path="Aplicativo"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
