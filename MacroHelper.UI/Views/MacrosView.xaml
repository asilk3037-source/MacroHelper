<UserControl x:Class="MacroHelper.UI.Views.MacrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MacroHelper.UI.ViewModels"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Tema do menu "Mais ações" (o WPF padrão não segue o tema claro/escuro do app) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- Fade + slide ao entrar -->
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                        From="0" To="1" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="PageSlide"
                        Storyboard.TargetProperty="Y"
                        From="10" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- PAINEL FORMULÁRIO (slide-in lateral) -->
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarFormulario}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#80000000" MouseLeftButtonDown="Overlay_Click"/>

            <Border HorizontalAlignment="Right" Width="520"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PainelFormulario" Margin="32,28" DataContext="{Binding FormularioAtual}"
                                DataContextChanged="PainelFormulario_DataContextChanged">

                        <!-- Header -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="{Binding TituloFormulario}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Preencha os dados da nova macro."/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEdicao}" Value="True">
                                                    <Setter Property="Text" Value="Atualize os dados da macro."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Command="{Binding AbrirHistoricoCommand}"
                                        Style="{StaticResource ButtonIconOnly}" Width="36" Height="36"
                                        ToolTip="Ver histórico de versões"
                                        Visibility="{Binding IsEdicao, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,4,0">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding CancelarCommand}"
                                        Style="{StaticResource ButtonIconOnly}" Width="36" Height="36">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Histórico de versões -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,12" Margin="0,0,0,18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarHistorico}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Histórico de versões" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                            Command="{Binding FecharHistoricoCommand}" Width="24" Height="24">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Historico}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DataModificacao, StringFormat=dd/MM/yyyy HH:mm}"
                                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Restaurar"
                                                        Style="{StaticResource ButtonSecondary}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RestaurarVersaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        Width="90" Height="30" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhuma versão anterior salva." FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Historico.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Erro -->
                        <Border Background="{DynamicResource DangerBgBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,10" Margin="0,0,0,18"
                                Visibility="{Binding ErroMensagem, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ErroMensagem}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Aviso de possível duplicata -->
                        <Border Background="{DynamicResource WarningBgBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,10" Margin="0,0,0,18"
                                Visibility="{Binding AvisoDuplicata, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding AvisoDuplicata}"
                                       Foreground="{DynamicResource WarningBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Templates prontos por setor (só ao criar uma macro nova) -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,18"
                                Visibility="{Binding MostrarTemplates, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="COMEÇAR DE UM TEMPLATE (OPCIONAL)" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbTemplate" Grid.Column="0"
                                              ItemsSource="{Binding TemplatesDisponiveis}"
                                              Height="38" FontSize="12" Margin="0,0,8,0"
                                              Background="{DynamicResource InputBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource InputBorderBrush}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Setor}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="—" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Titulo}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Usar" Style="{StaticResource ButtonSecondary}"
                                            Command="{Binding AplicarTemplateCommand}"
                                            CommandParameter="{Binding SelectedItem, ElementName=CmbTemplate}"
                                            Height="38" Padding="14,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Atalho -->
                        <TextBlock Text="ATALHO *" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding Atalho, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Minúsculas com hífens. Ex: chamado-recebido"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,18"/>

                        <!-- Título -->
                        <TextBlock Text="TÍTULO *" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,18"/>

                        <!-- Categoria -->
                        <TextBlock Text="CATEGORIA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Categorias}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CategoriaId}"
                                  Height="40" Margin="0,0,0,18"
                                  Background="{DynamicResource InputBgBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"
                                  FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nome}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Conteúdo -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="CONTEÚDO *" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                    Width="22" Height="22" ToolTip="Buscar e substituir"
                                    Click="BtnBuscarSubstituir_Click">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Barra de busca e substituição -->
                        <Border x:Name="PainelBuscaSubstituicao" Visibility="Collapsed"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBuscar" Style="{StaticResource InputStyle}" Height="32"
                                             TextChanged="TxtBuscar_TextChanged"/>
                                    <TextBlock x:Name="TxtContagemBusca" Grid.Column="1" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,2,0"/>
                                </Grid>
                                <TextBox x:Name="TxtSubstituir" Style="{StaticResource InputStyle}" Height="32"
                                         Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Anterior" Style="{StaticResource ButtonSecondary}"
                                            Width="80" Height="30" FontSize="11" Margin="0,0,6,0"
                                            Click="BtnBuscarAnterior_Click"/>
                                    <Button Content="Próximo" Style="{StaticResource ButtonSecondary}"
                                            Width="80" Height="30" FontSize="11" Margin="0,0,6,0"
                                            Click="BtnBuscarProximo_Click"/>
                                    <Button Content="Substituir" Style="{StaticResource ButtonSecondary}"
                                            Width="86" Height="30" FontSize="11" Margin="0,0,6,0"
                                            Click="BtnSubstituir_Click"/>
                                    <Button Content="Substituir tudo" Style="{StaticResource ButtonPrimary}"
                                            Width="116" Height="30" FontSize="11"
                                            Click="BtnSubstituirTudo_Click"/>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                            Width="28" Height="28" Margin="6,0,0,0"
                                            Click="BtnFecharBusca_Click">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource InputBorderBrush}"
                                Background="{DynamicResource InputBgBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid Height="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" ClipToBounds="True" Margin="0,12,0,12"
                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                    <Canvas x:Name="CanvasNumerosLinha"/>
                                </Border>
                                <TextBox x:Name="TxtConteudo" Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontFamily="Consolas" FontSize="13" Padding="8,12,12,12"
                                         Text="{Binding Conteudo, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="TxtConteudo_TextChanged"
                                         SizeChanged="TxtConteudo_SizeChanged"
                                         Loaded="TxtConteudo_Loaded"/>
                            </Grid>
                        </Border>

                        <!-- Dica de variáveis -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" Padding="12,8" Margin="0,6,0,18">
                            <WrapPanel>
                                <TextBlock Text="Variáveis: " FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{}{nome}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{}{data}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{}{hora}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{}{usuario}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </WrapPanel>
                        </Border>

                        <!-- Realce: variáveis e condicionais detectados no texto digitado -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" Padding="12,8" Margin="0,-12,0,18"
                                Visibility="{Binding HaTokensDetectados, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,4"
                                           Visibility="{Binding VariaveisNoConteudo.Count, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="Detectadas nesta macro: " FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,2"/>
                                    <ItemsControl ItemsSource="{Binding VariaveisNoConteudo}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="6"
                                                        Padding="6,2" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                                               FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <WrapPanel Visibility="{Binding CondicionaisNoConteudo.Count, Converter={StaticResource IntToVis}}">
                                    <TextBlock Text="Condicionais: " FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,2"/>
                                    <ItemsControl ItemsSource="{Binding CondicionaisNoConteudo}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource WarningBgBrush}" CornerRadius="6"
                                                        Padding="6,2" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10"
                                                               FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

        <!-- Atalho de teclado -->
                        <TextBlock Text="ATALHO DE TECLADO (OPCIONAL)" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="40" MaxLength="1"
                                 Text="{Binding AtalhoTecla, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Um dígito de 1 a 9. Insere via Ctrl+Alt+dígito."
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,18"/>

                        <!-- Imagem anexada (ex: assinatura) -->
                        <TextBlock Text="IMAGEM (OPCIONAL)" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding ColarImagemCommand}" HorizontalAlignment="Left"
                                    Height="36" Padding="14,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Colar imagem da área de transferência"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemImagem}" Value="True">
                                                    <Setter Property="Text" Value="Imagem anexada — colar para substituir"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource ButtonIconOnly}"
                                    Command="{Binding RemoverImagemCommand}"
                                    Visibility="{Binding TemImagem, Converter={StaticResource BoolToVis}}"
                                    Margin="8,0,0,0" Width="36" Height="36" ToolTip="Remover imagem">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Grupos com acesso (restrição por departamento) -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,12" Margin="0,0,0,18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Grupos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="Restringir a grupos" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Nenhum marcado = visível para todos os grupos."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Grupos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Nome}" IsChecked="{Binding Selecionado}"
                                                      Margin="0,0,0,6" FontSize="13"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Ativo -->
                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,12" Margin="0,0,0,16">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Macro ativa" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Macros inativas não aparecem nas sugestões."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding Ativo}"/>
                            </Grid>
                        </Border>

                        <!-- Painel de geração por texto (discreto, não "IA-first") -->
                        <Border CornerRadius="10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" Padding="14,12"
                                Margin="0,0,0,16"
                                Background="{DynamicResource SurfaceElevatedBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MostrarPainelIA}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Gerar conteúdo automaticamente"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Requer chave da API em Configurações."
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource ButtonIconOnly}"
                                            Command="{Binding FecharIACommand}">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="DESCRIÇÃO" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource InputBorderBrush}"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Margin="0,0,0,10">
                                    <TextBox BorderThickness="0" Background="Transparent"
                                             Height="70" TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="13" Padding="10,8"
                                             Text="{Binding DescricaoIA, UpdateSourceTrigger=PropertyChanged}"/>
                                </Border>
                                <Button Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding GerarComIACommand}"
                                        HorizontalAlignment="Right" Width="140" Height="36">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Gerar conteúdo"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GerandoIA}" Value="True">
                                                        <Setter Property="Text" Value="Gerando..."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding IaStatusMsg}"
                                   FontSize="11" Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding IaStatusMsg, Converter={StaticResource NullToVis}}"/>

                        <!-- Botões ação -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource ButtonIconOnly}"
                                    Command="{Binding AbrirIACommand}"
                                    Width="36" Height="36"
                                    ToolTip="Gerar conteúdo automaticamente">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE9CE;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MostrarPainelIA}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Grid Grid.Column="1"/>
                            <Button Grid.Column="2" Content="Cancelar"
                                    Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding CancelarCommand}"
                                    Margin="0,0,10,0" Width="100"/>
                            <Button Grid.Column="3" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding SalvarCommand}" Width="130">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Salvar macro"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSaving}" Value="True">
                                                    <Setter Property="Text" Value="Salvando..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL REJEIÇÃO (motivo) -->
        <Grid Panel.ZIndex="15">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarRejeicao}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#80000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="20">
                <StackPanel Margin="28,24">
                    <TextBlock Text="Rejeitar macro" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding MacroRejeitando.Titulo}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="MOTIVO (opcional, o autor verá esta mensagem)" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                             Text="{Binding MotivoRejeicao, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding CancelarRejeicaoCommand}" Margin="0,0,10,0" Width="100"/>
                        <Button Content="Rejeitar" Style="{StaticResource ButtonPrimary}"
                                Foreground="{DynamicResource DangerBrush}"
                                Command="{Binding ConfirmarRejeicaoCommand}" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CONTEÚDO PRINCIPAL -->
        <DockPanel>
            <!-- Cabeçalho -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    Padding="28,18,28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Macros" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Style="{StaticResource PageSubtitleText}">
                            <Run Text="{Binding Macros.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Run Text=" registros · organize, dispare e versione"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border CornerRadius="10" BorderThickness="1" Padding="3"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            Background="{DynamicResource SurfaceBrush}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Aprovações pendentes"
                                Command="{Binding TogglePendentesCommand}"
                                Width="34" Height="34" Margin="0,0,2,0">
                            <Grid>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource DangerBrush}"
                                        CornerRadius="10" Width="14" Height="14"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-4,-4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Pendentes.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Pendentes.Count}" FontSize="9" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding ToggleSomenteFavoritosCommand}"
                                ToolTip="Somente favoritos"
                                Width="34" Height="34" Margin="0,0,2,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE734;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SomenteFavoritos}" Value="True">
                                                <Setter Property="Text" Value="&#xE735;"/>
                                                <Setter Property="Foreground" Value="#F2C94C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding ToggleMostrarArquivadasCommand}"
                                ToolTip="Mostrar macros arquivadas"
                                Width="34" Height="34" Margin="0,0,2,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7B8;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MostrarArquivadas}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    </Border>

                    <Border CornerRadius="10" BorderThickness="1" Padding="3"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            Background="{DynamicResource SurfaceBrush}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Importar macros (JSON)"
                                Command="{Binding ImportarJsonCommand}"
                                Width="34" Height="34" Margin="0,0,2,0">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Importar macros (CSV/Excel exportado como CSV)"
                                Command="{Binding ImportarCsvCommand}"
                                Width="34" Height="34" Margin="0,0,2,0">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Exportar macros (JSON)"
                                Command="{Binding ExportarJsonCommand}"
                                Width="34" Height="34">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        </StackPanel>
                    </Border>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding NovaMacroCommand}"
                                IsEnabled="{Binding PodeEditarTela}"
                                ToolTip="Sem permissão para criar/editar macros"
                                Height="38" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Nova Macro" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Painel de aprovações pendentes -->
            <Border DockPanel.Dock="Top" Margin="28,12,28,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MostrarPendentes}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Macros pendentes de aprovação" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Pendentes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11" FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="/"/><Run Text="{Binding Atalho, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Aprovar" Style="{StaticResource ButtonPrimary}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.AprovarMacroCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="90" Height="32" Margin="0,0,8,0"/>
                                        <Button Content="Rejeitar" Style="{StaticResource ButtonSecondary}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.AbrirRejeicaoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="90" Height="32"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Busca e filtros -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="28,12,28,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            Background="{DynamicResource InputBgBrush}"
                            Margin="0,0,10,0" Height="40">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Margin="12,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="13" Padding="36,0,12,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Pesquisar macros..." FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="38,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TermoBusca}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaFiltro}"
                              Height="38"
                              Background="{DynamicResource InputBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}"
                              FontSize="13"/>
                </Grid>
            </Border>

            <!-- Loading -->
            <Border DockPanel.Dock="Top" Padding="28,4"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="Carregando..." FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Estado vazio -->
            <Border DockPanel.Dock="Top" Padding="28,60">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Macros.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Ícone geométrico sem emoji -->
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nenhuma macro encontrada" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text='Clique em "Nova Macro" para começar.'
                               FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Lista -->
            <ScrollViewer Padding="28,4,28,28" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Macros}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1" CornerRadius="16"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="rowLift" Y="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="rowShadow" Color="#221F30" ShadowDepth="2" BlurRadius="0" Opacity="0"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rowLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="rowShadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="rowShadow" Storyboard.TargetProperty="Opacity" To="0.10" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rowLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="rowShadow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="rowShadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Barra accent lateral -->
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Barra lateral colorida -->
                                    <Border Grid.Column="0" CornerRadius="2"
                                            Background="{DynamicResource AccentGradientBrush}"
                                            Opacity="0.8"
                                            Margin="0,16,0,16"/>

                                    <!-- Conteúdo -->
                                    <StackPanel Grid.Column="1" Margin="16,14,0,14">
                                        <WrapPanel Margin="0,0,0,7">
                                            <Border Background="{DynamicResource AccentLightBrush}"
                                                    CornerRadius="4" Padding="9,3" Margin="0,0,6,0">
                                                <TextBlock Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="12.5" FontFamily="Consolas"
                                                           FontWeight="Bold">
                                                    <Run Text="/"/><Run Text="{Binding Atalho, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,0"
                                                    Background="{DynamicResource TableHeaderBgBrush}"
                                                    Visibility="{Binding Categoria, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding Categoria}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="7,2"
                                                    Background="{DynamicResource WarningBgBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Arquivada"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           FontSize="11"/>
                                            </Border>
                                            <Border CornerRadius="4" Padding="7,2"
                                                    Background="{DynamicResource AccentLightBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorito}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Destaque"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="11"/>
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Titulo}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding Conteudo}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   MaxHeight="36"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>

                                        <TextBlock Margin="0,7,0,0" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontFamily="Consolas">
                                            <Run Text="Criada em "/>
                                            <Run Text="{Binding DataCriacao, StringFormat=dd/MM/yyyy, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Ações -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="10,0,14,0">
                                        <!-- Favorito pessoal (meu) -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Meu favorito"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.ToggleFavoritoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,2,0" Width="32" Height="32">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE734;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FavoritoPessoal}" Value="True">
                                                                <Setter Property="Text" Value="&#xE735;"/>
                                                                <Setter Property="Foreground" Value="#F2C94C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Copiar -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Copiar conteúdo"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.CopiarConteudoCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,2,0" Width="32" Height="32">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Editar -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Editar macro"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.EditarMacroCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.PodeEditarTela,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,2,0" Width="32" Height="32">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Separador antes do menu -->
                                        <Border Width="1" Height="18" Margin="6,0"
                                                Background="{DynamicResource BorderLightBrush}"
                                                VerticalAlignment="Center"/>

                                        <!-- Mais ações (destaque de equipe, e-mail, arquivar/restaurar, excluir) -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Mais ações" Cursor="Hand"
                                                Width="32" Height="32"
                                                Click="BtnMaisAcoes_Click">
                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Placement="Bottom" Opened="MenuMaisAcoes_Opened">
                                                    <MenuItem Header="Destacar para equipe" Click="MenuDestaqueEquipe_Click"/>
                                                    <MenuItem Header="Enviar por e-mail" Click="MenuEnviarEmail_Click"/>
                                                    <MenuItem Header="Arquivar macro" Click="MenuArquivar_Click"/>
                                                    <MenuItem Header="Restaurar macro" Click="MenuDesarquivar_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Excluir macro"
                                                              Foreground="{DynamicResource DangerBrush}" Click="MenuExcluir_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Toast -->
        <Border Panel.ZIndex="5"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                CornerRadius="12" Padding="14,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mensagem, Converter={StaticResource NullToVis}}"
                                     Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Mensagem}" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
