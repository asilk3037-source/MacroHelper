<UserControl x:Class="MacroHelper.UI.Views.IntimacoesDwLawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MacroHelper.UI.ViewModels"
             xmlns:conv="clr-namespace:MacroHelper.UI.Converters"
             Background="{DynamicResource BackgroundBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Status color map -->
        <!-- converters locais (os globais são herdados de App.xaml) -->

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- painel import -->
            <RowDefinition Height="*"/>     <!-- grid -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="⚖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Intimações DW LAW" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Controle de erros de acesso ao painel" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Filtros -->
                <StackPanel Orientation="Horizontal" Grid.Column="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                    <ComboBox Style="{StaticResource FilterCombo}"
                              ItemsSource="{Binding FiltroOpcoes}"
                              SelectedItem="{Binding FiltroStatus}"
                              Margin="0,0,10,0"/>
                    <Border Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Height="32" Width="220" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Buscar advogado, sistema..." VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0"
                                       FontSize="12" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FiltroTexto}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" Margin="8,0" FontSize="12"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Botão Novo Lote -->
                <Button Grid.Column="2" Command="{Binding AbrirPainelCommand}"
                        Height="36" Padding="16,0" FontSize="13" FontWeight="SemiBold"
                        Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+ " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Novo Lote" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ PAINEL IMPORT ════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,2"
                Padding="20,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Painel}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Linha 1: título + fechar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Importar novo lote de erros" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Command="{Binding FecharPainelCommand}"
                            Style="{StaticResource ButtonIconOnly}" ToolTip="Fechar">
                        <TextBlock Text="✕" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Linha 2: inputs -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Data do email -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Top">
                        <TextBlock Text="Data do email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding DataEmail}" Width="140" Height="34"/>
                    </StackPanel>

                    <!-- TextArea para colar ou PDF -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <!-- Cabeçalho da área de texto com botão PDF -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Cole o conteúdo do email ou selecione o PDF:" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding SelecionarPdfCommand}"
                                    Height="26" Padding="10,0" FontSize="12" BorderThickness="0"
                                    Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                    ToolTip="Selecionar arquivo PDF do email DW LAW">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📎" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Selecionar PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Background="{DynamicResource BackgroundBrush}">
                            <TextBox Text="{Binding TextoEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="12" Padding="8"/>
                        </Border>
                    </StackPanel>

                    <!-- Botões ação -->
                    <StackPanel Grid.Column="2" Margin="12,20,0,0" VerticalAlignment="Top" Width="130">
                        <Button Command="{Binding ExtrairCommand}" Height="36" FontSize="13"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                BorderThickness="0" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                            Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Height="36"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="🔍 Extrair" VerticalAlignment="Center" FontSize="13"/>
                        </Button>

                        <Button Command="{Binding ImportarLoteCommand}"
                                IsEnabled="{Binding TemPreview}"
                                Height="36" FontSize="13" BorderThickness="0"
                                Background="#10B981" Foreground="White">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7"
                                            Padding="12,0" Opacity="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource NullToBool}}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Height="36"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock VerticalAlignment="Center" FontSize="13">
                                <Run Text="✔ Importar ("/>
                                <Run Text="{Binding Preview.Count, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Linha 3: mensagem + preview -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding MsgExtracao}" FontSize="12" Margin="0,0,0,8"
                               Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding MsgExtracao, Converter={StaticResource NullToVis}}"/>

                    <!-- Preview grid -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" MaxHeight="200"
                            Visibility="{Binding TemPreview, Converter={StaticResource BoolToVis}}">
                        <DataGrid ItemsSource="{Binding Preview}" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                                  HeadersVisibility="Column" FontSize="12"
                                  CanUserResizeColumns="True" CanUserSortColumns="False"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Advogado"  Binding="{Binding Advogado}"  Width="200"/>
                                <DataGridTextColumn Header="Sistema"   Binding="{Binding Sistema}"   Width="160"/>
                                <DataGridTextColumn Header="Erro"      Binding="{Binding ErroTexto}" Width="*"/>
                                <DataGridTextColumn Header="Tipo Login" Binding="{Binding TipoLogin}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ GRID PRINCIPAL ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="16" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <!-- Loading overlay -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Opacity="0.7"
                        Visibility="{Binding Carregando, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="10">
                    <TextBlock Text="Carregando…" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Panel.ZIndex="5">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Itens.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⚖" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Nenhum erro registrado" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text='Clique em "+ Novo Lote" para importar o email do dia'
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Itens}" AutoGenerateColumns="False"
                          IsReadOnly="False" GridLinesVisibility="Horizontal"
                          Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource TableRowAltBrush}"
                          HeadersVisibility="Column" FontSize="12"
                          CanUserResizeColumns="True" CanUserSortColumns="True"
                          CanUserAddRows="False" BorderThickness="0"
                          SelectionMode="Single" RowHeight="42">
                    <DataGrid.Columns>

                        <!-- Data -->
                        <DataGridTextColumn Header="Data" Binding="{Binding DataFormatada}"
                                            Width="55" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Advogado -->
                        <DataGridTextColumn Header="Advogado" Binding="{Binding Advogado}"
                                            Width="190" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Sistema -->
                        <DataGridTextColumn Header="Sistema" Binding="{Binding Sistema}"
                                            Width="155" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Erro -->
                        <DataGridTextColumn Header="Erro" Binding="{Binding ErroTexto}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="ToolTip" Value="{Binding ErroTexto}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status (ComboBox inline) -->
                        <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="4,6" CornerRadius="10" Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <Binding Path="Status" Converter="{StaticResource StatusToColor}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.StatusOpcoes,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              Height="30" FontSize="12"
                                              LostFocus="StatusCombo_LostFocus"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Dias aberto -->
                        <DataGridTextColumn Header="Dias" Binding="{Binding DiasAberto}"
                                            Width="50" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Observação -->
                        <DataGridTextColumn Header="Observação"
                                            Binding="{Binding Observacao, UpdateSourceTrigger=LostFocus}"
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ações -->
                        <DataGridTemplateColumn Header="" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.AbrirLinkCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Abrir link do tribunal"
                                                Margin="2,0" Width="28" Height="28">
                                            <TextBlock Text="🔗" FontSize="13"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ExcluirCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Excluir"
                                                Margin="2,0" Width="28" Height="28">
                                            <TextBlock Text="🗑" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
