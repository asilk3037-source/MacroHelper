<Window x:Class="MacroHelper.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MacroHelper.UI.ViewModels"
        xmlns:views="clr-namespace:MacroHelper.UI.Views"
        xmlns:conv="clr-namespace:MacroHelper.UI.Converters"
        Title="SK MacroHelper" Height="720" Width="1140" xml:lang="pt-BR"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None" AllowsTransparency="True"
        Icon="/Resources/app.ico"
        Activated="Window_Activated">

    <Window.Resources>
        <conv:KioskSidebarWidthConverter x:Key="KioskSidebarWidthConverter"/>

        <!-- Estilo de nav item reutilizável -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="10"
                                    Background="{TemplateBinding Background}" Margin="4,0"/>
                            <!-- Barra de destaque à esquerda no item ativo: cor vem de BorderBrush (reaproveitado como "carrier") -->
                            <Border x:Name="accentBar" Width="3" Height="18" HorizontalAlignment="Left"
                                    CornerRadius="0,2,2,0" Background="{TemplateBinding BorderBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,10,0">
                                <TextBlock x:Name="icon"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SidebarItemHoverBrush}"/>
                                <Setter TargetName="icon" Property="Foreground"
                                        Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template de item de nav dinâmico, consumido pelos ItemsControl ligados a NavGeral/NavEquipe/NavSistema -->
        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <Button Tag="{Binding Icone}" Command="{Binding Comando}"
                    Visibility="{Binding Visivel, Converter={StaticResource BoolToVis}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarItemActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Ativo}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" ClipToBounds="True"
            BorderThickness="1" BorderBrush="{DynamicResource BorderLightBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ModoKiosk, Converter={StaticResource KioskSidebarWidthConverter}}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════ SIDEBAR (recolhida a 0 no modo totem) ══════════════ -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SidebarBorderBrush}"
                    ClipToBounds="True">
                <DockPanel>

                    <!-- Logo -->
                    <Border DockPanel.Dock="Top" Padding="18,20,18,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="13" Margin="0,0,12,0"
                                    Background="{DynamicResource AccentGradientBrush}">
                                <TextBlock Text="SK" FontSize="14" FontFamily="Segoe UI Semibold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SK" FontSize="15" FontFamily="Segoe UI Semibold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border Width="1" Height="13" Margin="6,0"
                                            Background="{DynamicResource BorderBrush}"/>
                                    <TextBlock Text="Macro" FontSize="14" FontFamily="Segoe UI Semibold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                                <TextBlock Text="HELPER PRO" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SidebarMutedBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <Border DockPanel.Dock="Top" Padding="14,0,14,12">
                        <Border Padding="11,8" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource SidebarBorderBrush}"
                                Background="{DynamicResource SurfaceBrush}" Opacity="0.7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Dot pulsando -->
                                <Ellipse Grid.Column="0" x:Name="StatusDot" Width="6" Height="6"
                                         Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                        From="1" To="0.25" Duration="0:0:1.2" AutoReverse="True">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SidebarTextBrush}"
                                           Text="Hook ativo"/>
                                <TextBlock Grid.Column="2" FontSize="9"
                                           Foreground="{DynamicResource SidebarMutedBrush}"
                                           VerticalAlignment="Center">
                                    <Run Text="{Binding TotalMacros, Mode=OneWay}"/>
                                    <Run Text=" macros"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom" Padding="14,12"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource SidebarBorderBrush}">
                        <StackPanel>
                            <!-- Atalho de busca rápida (pill com borda tracejada) -->
                            <Border Margin="0,0,0,8" Padding="9,7" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="{DynamicResource SidebarBorderBrush}"
                                    Background="{DynamicResource SurfaceElevatedBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource SidebarBorderBrush}"
                                            CornerRadius="5" Padding="5,2" Margin="0,0,6,0">
                                        <TextBlock Text="Ctrl+Espaço" FontSize="9"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Border>
                                    <TextBlock Text="busca rápida" FontSize="10"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Crédito -->
                            <Border Margin="0,0,0,10" Padding="10,7" CornerRadius="10"
                                    BorderThickness="1" BorderBrush="{DynamicResource SidebarBorderBrush}"
                                    Background="{DynamicResource SurfaceBrush}" Opacity="0.6"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Desenvolvido por " FontSize="9"
                                               Foreground="{DynamicResource SidebarMutedBrush}"/>
                                    <TextBlock Text="Aline Martins" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Usuário -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                        Background="{DynamicResource AccentLightBrush}">
                                    <TextBlock Text="{Binding NomeUsuario, Converter={StaticResource NameInitials}}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource SidebarTextActiveBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding NomeUsuario, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource ButtonIconOnly}"
                                        Command="{Binding LogoutCommand}" Width="28" Height="28"
                                        ToolTip="Sair" AutomationProperties.AutomationId="LogoutButton"
                                        AutomationProperties.Name="Sair">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource SidebarMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── NAV (gerada dinamicamente a partir de NavGeral/NavEquipe/NavSistema) — último filho: ocupa o espaço restante ── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Text="GERAL" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarMutedBrush}" Margin="20,6,0,4"/>
                            <ItemsControl ItemsSource="{Binding NavGeral}" ItemTemplate="{StaticResource NavItemTemplate}" Margin="4,0"/>

                            <TextBlock Text="EQUIPE" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarMutedBrush}" Margin="20,14,0,4"
                                       Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding NavEquipe}" ItemTemplate="{StaticResource NavItemTemplate}" Margin="4,0"/>

                            <TextBlock Text="SISTEMA" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SidebarMutedBrush}" Margin="20,14,0,4"/>
                            <ItemsControl ItemsSource="{Binding NavSistema}" ItemTemplate="{StaticResource NavItemTemplate}" Margin="4,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ══════════════ MAIN CONTENT ══════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0,16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding StatusMensagem}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Margin="0,0,176,0"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding SairDoModoKioskCommand}"
                                Visibility="{Binding ModoKiosk, Converter={StaticResource BoolToVis}}"
                                Height="30" Padding="12,0" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Sair do modo totem" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Click="SearchButton_Click" Width="32" Height="32" Margin="0,0,2,0"
                                    ToolTip="Busca rápida (Ctrl+Espaço)"
                                    AutomationProperties.AutomationId="SearchButton"
                                    AutomationProperties.Name="Busca rápida">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Command="{Binding NavigarParaNotificacoesCommand}" Width="32" Height="32" Margin="0,0,2,0">
                                <Grid>
                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="7"
                                            Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-2,-2,0"
                                            Visibility="{Binding NotificacoesNaoLidas, Converter={StaticResource IntToVis}}">
                                        <TextBlock Text="{Binding NotificacoesNaoLidas}" FontSize="8" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Click="MinimizeButton_Click" Width="32" Height="32">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Click="MaximizeButton_Click" Margin="2,0" Width="32" Height="32">
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Click="CloseButton_Click" Width="32" Height="32"
                                    Cursor="Hand" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="8"
                                                Background="{TemplateBinding Background}">
                                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Banner de atualização disponível -->
                <Border Grid.Row="1"
                        Background="{DynamicResource AccentLightBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AccentBrush}"
                        Padding="20,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MostrarBannerAtualizacao}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="Nova versão"/>
                                <Run Text="{Binding VersaoNova, Mode=OneWay}" FontWeight="Bold"
                                     Foreground="{DynamicResource AccentBrush}"/>
                                <Run Text="disponível"/>
                            </TextBlock>
                            <TextBlock Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding PodeInstalarUpdate, Converter={StaticResource BoolToVis}}">
                                — o app vai fechar, se atualizar e reabrir automaticamente
                            </TextBlock>
                        </StackPanel>
                        <!-- Botão Atualizar -->
                        <Button Grid.Column="2" Margin="12,0,8,0" Height="30" Padding="14,0"
                                Style="{StaticResource ButtonPrimary}" FontSize="11"
                                Command="{Binding AplicarAtualizacaoCommand}"
                                IsEnabled="{Binding BaixandoUpdate, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE896;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BaixandoUpdate}" Value="True">
                                                    <Setter Property="Text" Value="&#xE895;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Atualizar agora"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BaixandoUpdate}" Value="True">
                                                    <Setter Property="Text" Value="Baixando..."/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PodeInstalarUpdate}" Value="False">
                                                    <Setter Property="Text" Value="Ver release"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <!-- Botão Ignorar -->
                        <Button Grid.Column="3" Width="28" Height="28"
                                Style="{StaticResource ButtonIconOnly}"
                                Command="{Binding IgnorarAtualizacaoCommand}"
                                ToolTip="Ignorar esta atualização">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content router com animação de transição -->
                <ContentControl Grid.Row="2" Content="{Binding CurrentView}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:MacrosViewModel}">
                            <views:MacrosView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
                            <views:ConfiguracoesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
                            <views:CategoriasView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:RelatorioViewModel}">
                            <views:RelatorioView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:UsuariosViewModel}">
                            <views:UsuariosView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:VariaveisGlobaisViewModel}">
                            <views:VariaveisGlobaisView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoricoVersoesViewModel}">
                            <views:HistoricoVersoesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AgendamentosViewModel}">
                            <views:AgendamentosView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:GruposViewModel}">
                            <views:GruposView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
                            <views:AuditoriaView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ComunidadeViewModel}">
                            <views:ComunidadeView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PermissoesViewModel}">
                            <views:PermissoesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:IntegracoesViewModel}">
                            <views:IntegracoesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NotificacoesViewModel}">
                            <views:NotificacoesView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PerfilViewModel}">
                            <views:PerfilView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AjudaViewModel}">
                            <views:AjudaView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjetosViewModel}">
                            <views:ProjetosView/>
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</Window>
