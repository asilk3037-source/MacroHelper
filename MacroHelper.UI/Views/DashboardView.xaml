<UserControl x:Class="MacroHelper.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}"
                Padding="28,18">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="Olá, "/><Run Text="{Binding NomeUsuario, Mode=OneWay}"/><Run Text="!"/>
                </TextBlock>
                <TextBlock Text="Aqui está um resumo da sua atividade no SK MacroHelper"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="28,20,28,28">
            <StackPanel>
                <!-- Cards de estatística -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardStyle}" Padding="20,18">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,0,12"
                                    Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TotalMacros, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="macros cadastradas" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="4,0" Style="{StaticResource CardStyle}" Padding="20,18">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,0,12"
                                    Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding UsadasHoje, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="usos hoje" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource CardStyle}" Padding="20,18">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,0,12"
                                    Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding MinutosEconomizados, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="economizados este mês" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Mais usadas + Atividade recente -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource CardStyle}" Padding="20,18">
                        <StackPanel MinHeight="120">
                            <TextBlock Text="Macros mais usadas (mês)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding MaisUsadas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                    <Run Text="/"/><Run Text="{Binding Atalho}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}"
                                                    CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}">
                                                    <Run Text="{Binding Total}"/><Run Text=" usos"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding MaisUsadas.Count, Converter={StaticResource IntZeroToVis}}">
                                <TextBlock Text="Nenhuma macro usada ainda este mês" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CardStyle}" Padding="20,18">
                        <StackPanel MinHeight="120">
                            <TextBlock Text="Atividade recente" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding AtividadeRecente}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Titulo}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Run Text="{Binding Data, StringFormat=dd/MM HH:mm}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding AtividadeRecente.Count, Converter={StaticResource IntZeroToVis}}">
                                <TextBlock Text="Nenhuma atividade registrada ainda" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
