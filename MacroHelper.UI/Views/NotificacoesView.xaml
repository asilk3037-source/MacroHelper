<UserControl x:Class="MacroHelper.UI.Views.NotificacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}" Margin="0,0,14,0" Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notificações" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="Eventos do sistema: backups, novos usuários e mais." Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding MarcarTodasComoLidasCommand}" Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Marcar todas como lidas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding LimparCommand}" Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Padding="28,14,28,28">
            <ItemsControl ItemsSource="{Binding Notificacoes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18,14" Margin="0,0,0,6"
                                Cursor="Hand" MouseLeftButtonUp="Item_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Lida}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource IconTileSmall}">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Sucesso">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Erro">
                                                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tipo}" Value="Aviso">
                                                    <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xEA8F;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Sucesso">
                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Erro">
                                                        <Setter Property="Text" Value="&#xE783;"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Tipo}" Value="Aviso">
                                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Mensagem}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Data, StringFormat='dd/MM HH:mm'}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="10,2,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
