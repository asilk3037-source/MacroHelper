<Window x:Class="MacroHelper.UI.Views.BuscadorRapidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="20" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>

            <!-- Campo de busca -->
            <Border Padding="14,12" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="11" Margin="0,0,10,0"
                            Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="TxtBusca" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             FontSize="16" Padding="0,2"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtBusca_TextChanged"
                             KeyDown="TxtBusca_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="Buscar macro..."
                               FontSize="16" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtBusca}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="ESC para fechar"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Resultados -->
            <ListBox x:Name="ListResultados"
                     Background="Transparent" BorderThickness="0"
                     MaxHeight="360" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="ListResultados_KeyDown"
                     MouseLeftButtonUp="ListResultados_MouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="16,11"/>
                        <Setter Property="Margin" Value="8,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bg" CornerRadius="12" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Titulo}" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Conteudo}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           MaxHeight="28" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="BtnFavorito_Click" Tag="{Binding}"
                                    Width="26" Height="26" Margin="6,0" VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE734;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Favorito}" Value="True">
                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                    <Setter Property="Foreground" Value="#F2C94C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Border Grid.Column="2" CornerRadius="7" Padding="8,3"
                                    Background="{DynamicResource AccentLightBrush}"
                                    VerticalAlignment="Top" Margin="0,0,0,0">
                                <TextBlock Text="{Binding Atalho}" FontFamily="Consolas"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Preview ao vivo -->
            <Border x:Name="PainelPreview" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    Padding="16,10" MaxHeight="90" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="70">
                    <TextBlock x:Name="TxtPreview" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </ScrollViewer>
            </Border>

            <!-- Estado vazio -->
            <Border Padding="20,24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count, ElementName=ListResultados}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13">
                    <Run Text="Nenhuma macro encontrada para "/>
                    <Run Text="&quot;" />
                    <Run Text="{Binding Text, ElementName=TxtBusca}"/>
                    <Run Text="&quot;" />
                </TextBlock>
            </Border>

            <!-- Footer -->
            <Border Padding="14,8" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Style="{StaticResource KbdChip}" Margin="0,0,4,0">
                            <TextBlock Text="↑↓" Style="{StaticResource KbdChipText}"/>
                        </Border>
                        <TextBlock Text="navegar  " FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KbdChip}" Margin="0,0,4,0">
                            <TextBlock Text="Enter" Style="{StaticResource KbdChipText}"/>
                        </Border>
                        <TextBlock Text="inserir  " FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KbdChip}" Margin="0,0,4,0">
                            <TextBlock Text="Ctrl+Espaço" Style="{StaticResource KbdChipText}"/>
                        </Border>
                        <TextBlock Text="abrir/fechar" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="9.5"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                        <Run Text="{Binding Items.Count, ElementName=ListResultados, Mode=OneWay}"/>
                        <Run Text=" resultados"/>
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
