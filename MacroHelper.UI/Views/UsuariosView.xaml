<UserControl x:Class="MacroHelper.UI.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
    <!-- Painel permissões (sidebar direita) -->
    <Grid Panel.ZIndex="10">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MostrarPermissoes}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#80000000"/>
        <Border HorizontalAlignment="Right" Width="420"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource BorderBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,26">
                    <TextBlock Text="Acesso e permissões" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding UsuarioPermissoes.Nome}" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16">
                        <Run Text="Para ações extras específicas (ex: excluir macros de outros, gerenciar categorias), use a tela "/>
                        <Run Text="Permissões" FontWeight="SemiBold"/><Run Text=" no menu."/>
                    </TextBlock>

                    <TextBlock Text="Categorias visíveis" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Nenhuma categoria marcada = acesso a todas as categorias."
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                    <ItemsControl ItemsSource="{Binding CategoriasPermissao}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Nome}" IsChecked="{Binding Selecionada}"
                                          Margin="0,0,0,10" FontSize="13"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Grupo / departamento" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,8"/>
                    <ComboBox ItemsSource="{Binding GruposDisponiveis}"
                              SelectedValuePath="Id" SelectedValue="{Binding GrupoSelecionadoId}"
                              Height="38" Margin="0,0,0,10"
                              Background="{DynamicResource InputBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}" FontSize="13">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Nome}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" Height="36"
                                 Text="{Binding NovoGrupoNome, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Novo grupo" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding AdicionarGrupoCommand}" Height="36" Padding="12,0"/>
                    </Grid>

                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderLightBrush}" Margin="0,8,0,16" Padding="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Permissões por tela" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>

                            <Border Padding="10,8" CornerRadius="8" Margin="0,0,0,10"
                                    Background="{DynamicResource SuccessBgBrush}"
                                    Visibility="{Binding UsuarioPermissoes.Perfil, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Admin}">
                                <TextBlock Text="Administradores têm acesso total a todas as telas." FontSize="11"
                                           Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <ItemsControl ItemsSource="{Binding PermissoesTela}"
                                          Visibility="{Binding UsuarioPermissoes.Perfil, Converter={StaticResource StringEqualsToVis}, ConverterParameter=Usuario}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding DataContext.NiveisDisponiveis,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding Nivel}"
                                                      Height="30" FontSize="11"
                                                      Background="{DynamicResource InputBgBrush}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      BorderBrush="{DynamicResource InputBorderBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="Cancelar"
                                Style="{StaticResource ButtonSecondary}"
                                Command="{Binding FecharPermissoesCommand}"
                                Margin="0,0,10,0" Width="100"/>
                        <Button Grid.Column="2" Content="Salvar"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarPermissoesCommand}"
                                Width="100"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

    <!-- Modal criar/editar usuário -->
    <Grid Panel.ZIndex="11">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MostrarFormUsuario}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#80000000"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="420" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1" CornerRadius="20">
            <StackPanel Margin="28,24">
                <Grid Margin="0,0,0,20">
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Editar usuário"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsuarioEditando}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Novo usuário"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                            Command="{Binding CancelarFormUsuarioCommand}" Width="28" Height="28">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Border Background="{DynamicResource DangerBgBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12,9" Margin="0,0,0,14"
                        Visibility="{Binding FormErro, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding FormErro}"
                               Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="NOME *" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource InputStyle}" Height="42"
                         Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="FormNomeTextBox"
                         Margin="0,0,0,14"/>

                <TextBlock Text="E-MAIL *" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource InputStyle}" Height="42"
                         Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="FormEmailTextBox"
                         Margin="0,0,0,14"/>

                <StackPanel Visibility="{Binding UsuarioEditando, Converter={StaticResource ObjNullToVis}, ConverterParameter=invert}">
                    <TextBlock Text="SENHA INICIAL *" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="42"
                             Text="{Binding FormSenha, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="FormSenhaTextBox"
                             Margin="0,0,0,14"/>
                </StackPanel>

                <CheckBox Content="Conta ativa" IsChecked="{Binding FormAtivo}"
                          FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                <TextBlock Text="PERFIL" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                <RadioButton GroupName="Perfil" Content="Usuário comum"
                             IsChecked="{Binding FormPerfil, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Usuario, Mode=OneWay}"
                             Checked="RadioPerfilUsuario_Checked"
                             FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <RadioButton GroupName="Perfil" Content="Administrador (acesso total a todas as telas)"
                             IsChecked="{Binding FormPerfil, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Admin, Mode=OneWay}"
                             Checked="RadioPerfilAdmin_Checked"
                             FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <RadioButton GroupName="Perfil" Content="Auditor (somente leitura — vê tudo, não pode editar/excluir)"
                             IsChecked="{Binding FormPerfil, Converter={StaticResource StringEqualsToBool}, ConverterParameter=Auditor, Mode=OneWay}"
                             Checked="RadioPerfilAuditor_Checked"
                             FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Padding="10,8" CornerRadius="8" Margin="0,0,0,16"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        Visibility="{Binding UsuarioEditando, Converter={StaticResource ObjNullToVis}, ConverterParameter=invert}">
                    <TextBlock Text="Categorias, grupo e permissões por tela podem ser configurados depois, pelo ícone de engrenagem na lista."
                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                            Command="{Binding CancelarFormUsuarioCommand}"
                            Margin="0,0,10,0" Width="100"/>
                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SalvarUsuarioCommand}" Width="130"
                            AutomationProperties.AutomationId="SalvarUsuarioButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}"
                Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Usuários" Style="{StaticResource PageTitleText}"/>
                        <Border Style="{StaticResource BadgePill}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Usuarios.Count}" Style="{StaticResource BadgePillText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Gerencie os usuários com acesso ao MacroHelper."
                               Style="{StaticResource PageSubtitleText}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding NovoUsuarioCommand}" Height="38" Padding="16,0"
                        IsEnabled="{Binding PodeEditarTela}" ToolTip="Sem permissão para criar/editar usuários"
                        AutomationProperties.AutomationId="NovoUsuarioButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Novo Usuário" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Padding="28,16,28,28">
            <StackPanel>
                <!-- Cabeçalho de colunas -->
                <Grid Margin="0,0,0,6" Visibility="{Binding Usuarios.Count, Converter={StaticResource ObjNullToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="PESSOA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="PERFIL" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Usuarios}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="14,12" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="15" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Nome[0]}"/>
                                    </Border>

                                    <!-- Nome + email -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Email}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Badge perfil -->
                                    <Border Grid.Column="2" CornerRadius="5" Padding="8,3"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perfil}" Value="Admin">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Perfil}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Perfil}" Value="Admin">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Badge status -->
                                    <Border Grid.Column="3" CornerRadius="5" Padding="8,3"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Inativo"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Text" Value="Ativo"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ações -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Engrenagem -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Permissões por categoria e por tela"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.AbrirPermissoesCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="32" Height="32">
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <!-- Editar -->
                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                ToolTip="Editar usuário"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.EditarUsuarioCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsEnabled="{Binding DataContext.PodeEditarTela,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="2,0,0,0" Width="32" Height="32">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- Separador vertical -->
                                        <Rectangle Width="1" Height="20" Margin="6,0"
                                                   Fill="{DynamicResource BorderLightBrush}" VerticalAlignment="Center"/>

                                        <!-- Lixeira (1º clique arma a confirmação) -->
                                        <Button ToolTip="Excluir usuário" Cursor="Hand"
                                                Width="32" Height="32" BorderThickness="0"
                                                Background="Transparent"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.PodeExcluirTela,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Command="{Binding DataContext.ExcluirUsuarioCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource EqualsToVis}" ConverterParameter="invert">
                                                    <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="Id"/>
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Confirmar / cancelar -->
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Visibility>
                                                <MultiBinding Converter="{StaticResource EqualsToVis}">
                                                    <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="Id"/>
                                                </MultiBinding>
                                            </StackPanel.Visibility>
                                            <Button Content="Confirmar" Style="{StaticResource ButtonSecondary}"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ExcluirUsuarioCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Style="{StaticResource ButtonIconOnly}"
                                                    Command="{Binding DataContext.CancelarExclusaoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Width="28" Height="28">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <Border Padding="60,40">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Usuarios.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="14"
                                Background="{DynamicResource SurfaceBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nenhum usuário encontrado"
                                   FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    </Grid>
</UserControl>
