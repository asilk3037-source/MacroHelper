<UserControl x:Class="MacroHelper.UI.Views.PerfilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}" Padding="28,18">
            <StackPanel>
                <TextBlock Text="Meu Perfil" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Seus dados de acesso e senha." Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Padding="28,22,28,28">
            <Grid MaxWidth="820">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Dados pessoais ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <!-- Avatar + título -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="{DynamicResource AccentLightBrush}" Margin="0,0,13,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Iniciais}"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dados pessoais" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                            Background="{DynamicResource AccentLightBrush}">
                                        <TextBlock Text="{Binding Perfil}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DataCriacaoFormatada}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Feedback perfil -->
                        <Border Background="{DynamicResource SuccessBgBrush}"
                                BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                                Visibility="{Binding MensagemPerfil, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding MensagemPerfil}"
                                       Foreground="{DynamicResource SuccessBrush}" FontSize="12"/>
                        </Border>

                        <TextBlock Text="NOME" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="38"
                                 Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="E-MAIL" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="38"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                        <Button Content="Salvar perfil" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarPerfilCommand}"
                                HorizontalAlignment="Left" Width="130"/>
                    </StackPanel>
                </Border>

                <!-- ── Trocar senha ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Trocar senha" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Mínimo de 8 caracteres, com um número." FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- Feedback senha -->
                        <Border CornerRadius="8" BorderThickness="1" Padding="12,9" Margin="0,0,0,14"
                                Visibility="{Binding MensagemSenha, Converter={StaticResource NullToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemSenhaSucesso}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding MensagemSenha}" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MensagemSenhaSucesso}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="SENHA ATUAL" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="SenhaAtualBox" Height="38" Margin="0,0,0,14" FontSize="13"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     PasswordChanged="SenhaAtualBox_PasswordChanged"/>

                        <TextBlock Text="NOVA SENHA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="NovaSenhaBox" Height="38" Margin="0,0,0,6" FontSize="13"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     PasswordChanged="NovaSenhaBox_PasswordChanged"/>

                        <!-- Barra de força -->
                        <Grid Margin="0,0,0,14"
                              Visibility="{Binding SenhaForcaLabel, Converter={StaticResource StringToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Height="3" Value="{Binding SenhaForcaPercent, Mode=OneWay}" Maximum="100">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SenhaForcaLabel}" Value="Boa">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SenhaForcaLabel}" Value="Forte">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Grid.Column="1" Text="{Binding SenhaForcaLabel}"
                                       FontSize="10" FontWeight="SemiBold" Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SenhaForcaLabel}" Value="Boa">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SenhaForcaLabel}" Value="Forte">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="CONFIRMAR NOVA SENHA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="ConfirmarSenhaBox" Height="38" Margin="0,0,0,18" FontSize="13"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     PasswordChanged="ConfirmarSenhaBox_PasswordChanged"/>

                        <Button Content="Trocar senha" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding TrocarSenhaCommand}"
                                HorizontalAlignment="Left" Width="130"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
