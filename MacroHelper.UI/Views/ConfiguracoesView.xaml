<UserControl x:Class="MacroHelper.UI.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             PreviewKeyDown="ConfiguracoesView_PreviewKeyDown">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" Margin="40,30,40,40" HorizontalAlignment="Left">

            <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Personalize o SK MacroHelper conforme suas preferências."
                       FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,0,0,30"/>

            <!-- Toast -->
            <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,18"
                    Visibility="{Binding Mensagem, Converter={StaticResource NullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensagemSucesso}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MensagemSucesso}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- ── TEMA ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Aparência" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Sistema -->
                        <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10"
                                Padding="14,18" Cursor="Hand" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Sistema">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Sistema"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Sistema" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Segue o Windows" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Claro -->
                        <Border Grid.Column="1" Margin="4,0" CornerRadius="10"
                                Padding="14,18" Cursor="Hand" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Claro">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Claro"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Claro" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interface clara" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Escuro -->
                        <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="10"
                                Padding="14,18" Cursor="Hand" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Escuro">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Escuro"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Escuro" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interface escura" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── APARÊNCIA AVANÇADA / IDIOMA ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Personalização" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="COR DE DESTAQUE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{Binding CoresAccentDisponiveis}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0"
                                            Background="{Binding}" Cursor="Hand" BorderThickness="2"
                                            BorderBrush="{DynamicResource BorderBrush}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AplicarCorAccentCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="IDIOMA DA INTERFACE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Button Content="Português (BR)" Width="150" Height="34" Margin="0,0,10,0"
                                Command="{Binding AplicarIdiomaCommand}" CommandParameter="pt-BR">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IdiomaSelecionado}" Value="pt-BR">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="English" Width="150" Height="34"
                                Command="{Binding AplicarIdiomaCommand}" CommandParameter="en-US">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IdiomaSelecionado}" Value="en-US">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Suporte completo a idiomas ainda é parcial (rótulos principais); a tradução total da interface está nos próximos passos."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding RefazerTourCommand}"
                            HorizontalAlignment="Left" Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Rever tour de boas-vindas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── BANCO / MODO EQUIPE ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Modo Equipe" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource AccentLightBrush}"
                                CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                            <TextBlock Text="NOVO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,18" TextWrapping="Wrap">
                        Aponte o banco de dados para uma pasta de rede compartilhada e toda a equipe usa as mesmas macros — sem servidor, sem internet.
                    </TextBlock>

                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <TextBlock Text="{Binding StatusBanco}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="CAMINHO DO BANCO (.db)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding CaminhoBanco, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarBancoCommand}"
                                Content="Aplicar" Width="80" Height="40"/>
                    </Grid>

                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10">
                        <Run Text="Para modo equipe, use um caminho de rede:  "/>
                        <Run Text="\\servidor\MacroHelper\macros.db" FontFamily="Consolas"
                             FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                    </TextBlock>

                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding UsarBancoLocalCommand}"
                            HorizontalAlignment="Left" Height="34" Padding="14,0" FontSize="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Voltar para banco local" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── GATILHO E DIGITAÇÃO ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Gatilho e Digitação" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="PREFIXO DO GATILHO" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40" MaxLength="1"
                             Text="{Binding GatilhoPrefixo, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4" Width="80" HorizontalAlignment="Left"/>
                    <TextBlock Text="Caractere usado para acionar a sugestão de macros. Padrão: /"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="APLICATIVOS NO MODO DIGITAÇÃO (FALLBACK)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40"
                             Text="{Binding AppsModoDigitacao, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Nomes de janela separados por ; (ex: Terminal;PuTTY). Nesses apps, o texto é digitado em vez de colado."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Sugestão proativa de macro" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Avisa quando você digita a mesma frase repetidamente, sugerindo criar uma macro."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding SugestaoProativaIA}"/>
                    </Grid>

                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SalvarGatilhoCommand}"
                            HorizontalAlignment="Left" Content="Salvar" Width="100" Height="38"/>
                </StackPanel>
            </Border>

            <!-- ── DITADO POR VOZ ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Ditado por Voz" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,4">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Modo contínuo (palavra de ativação)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Fica sempre ouvindo em segundo plano. Diga &quot;ei macro, inserir &lt;atalho&gt;&quot; a qualquer momento — sem precisar de Ctrl+Alt+V antes. Quando desligado, use Ctrl+Alt+V para ativar o ditado manualmente."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsChecked="{Binding DitadoModoContinuo, Mode=OneWay}"
                                  Command="{Binding AlternarDitadoModoContinuoCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── BACKUP AUTOMÁTICO ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Backup Automático" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Backup diário automático" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Copia o banco de dados a cada 24h, mantendo as últimas 14 versões."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding BackupAutomatico}"/>
                    </Grid>

                    <TextBlock Text="PASTA DE BACKUP" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40"
                             Text="{Binding PastaBackup, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarBackupConfigCommand}"
                                Content="Salvar" Width="100" Height="38" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding FazerBackupAgoraCommand}"
                                Width="140" Height="38">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Fazer backup agora"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FazendoBackup}" Value="True">
                                                <Setter Property="Text" Value="Fazendo backup..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── SINCRONIZAÇÃO (API) ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Sincronização via Servidor" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,16" TextWrapping="Wrap">
                        Sincroniza macros com o servidor MacroHelper.API: envia o que só existe localmente e recebe o que só existe no servidor.
                    </TextBlock>

                    <TextBlock Text="URL DO SERVIDOR" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40"
                             Text="{Binding ApiServidorUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="E-MAIL" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource InputStyle}" Height="40"
                                     Text="{Binding SyncEmail, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="SENHA" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <PasswordBox Height="40" Background="{DynamicResource InputBgBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="13" Padding="10,0"
                                         PasswordChanged="PasswordSync_Changed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding VerificarServidorCommand}"
                                Width="150" Height="34" Margin="0,0,10,0">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Testar conexão"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VerificandoServidor}" Value="True">
                                                <Setter Property="Text" Value="Testando..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Border CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServidorOnline}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ServidorOnline}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServidorOnline}" Value="True">
                                                <Setter Property="Text" Value="Online"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ServidorOnline}" Value="False">
                                                <Setter Property="Text" Value="Offline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonSecondary}"
                                Command="{Binding SalvarServidorSyncCommand}"
                                Content="Salvar servidor" Width="130" Height="38" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SincronizarCommand}"
                                Width="140" Height="38">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Sincronizar agora"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Sincronizando}" Value="True">
                                                <Setter Property="Text" Value="Sincronizando..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── IA ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Inteligência Artificial" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IaConfigurada}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="9" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="NÃO CONFIGURADA"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IaConfigurada}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;  ATIVA"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,18" TextWrapping="Wrap">
                        Com a IA ativa, você pode gerar conteúdo de macros por descrição, ajustar tom e sugerir atalhos automaticamente.
                    </TextBlock>

                    <TextBlock Text="CHAVE DA API ANTHROPIC" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding ChaveIA, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarChaveIACommand}"
                                Content="Salvar" Width="80" Height="40"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                        Obtenha sua chave em: <Run Foreground="{DynamicResource AccentBrush}"
                                                    FontWeight="SemiBold">console.anthropic.com</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── COMPORTAMENTO ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Comportamento" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                                <TextBlock Text="Iniciar com o Windows" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="O MacroHelper inicia automaticamente ao ligar o PC."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IniciarComWindows}"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Minimizar para a bandeja do sistema"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Ao fechar, o app continua rodando em segundo plano."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding MinimizarParaBandeja}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── MODO TOTEM / KIOSK ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Modo Totem" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Tela cheia, sem barra lateral" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Ideal para terminais de atendimento compartilhados. A janela é maximizada e a navegação some — use o botão &quot;Sair do modo totem&quot; para voltar."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Top"
                                  IsChecked="{Binding ModoKiosk, Mode=OneWay}"
                                  Command="{Binding AlternarModoKioskCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── ATALHOS DE TECLADO ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                Background="{DynamicResource AccentLightBrush}">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Atalhos de Teclado" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Clique no atalho e pressione a nova combinação de teclas."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                    <!-- Busca rápida -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Busca rápida" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Abre o buscador de macros em qualquer lugar do Windows."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="170" Height="36"
                                Command="{Binding IniciarCapturaAtalhoCommand}" CommandParameter="busca">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CapturandoAtalho}" Value="busca">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AtalhoBuscaTexto}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapturandoAtalho}" Value="busca">
                                                <Setter Property="Text" Value="Pressione uma tecla..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!-- Repetir última macro -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Repetir última macro" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sempre com o prefixo Ctrl + Alt — você escolhe a tecla final."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="170" Height="36"
                                Command="{Binding IniciarCapturaAtalhoCommand}" CommandParameter="repetir">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CapturandoAtalho}" Value="repetir">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AtalhoRepetirTexto}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapturandoAtalho}" Value="repetir">
                                                <Setter Property="Text" Value="Pressione uma tecla..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!-- Ditado por voz -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Ditado por voz" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sempre com o prefixo Ctrl + Alt — você escolhe a tecla final."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="170" Height="36"
                                Command="{Binding IniciarCapturaAtalhoCommand}" CommandParameter="ditado">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CapturandoAtalho}" Value="ditado">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AtalhoDitadoTexto}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapturandoAtalho}" Value="ditado">
                                                <Setter Property="Text" Value="Pressione uma tecla..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Button Content="Restaurar padrão" Style="{StaticResource ButtonSecondary}"
                            Command="{Binding RestaurarAtalhosPadraoCommand}"
                            HorizontalAlignment="Left" Width="140" Height="34" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ── SAÚDE DO APP ── -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24,20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="7" Margin="0,0,10,0"
                                    Background="{DynamicResource AccentLightBrush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Saúde do App" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                Command="{Binding CarregarSaudeCommand}" ToolTip="Atualizar">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BancoIntegro}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Banco de dados íntegro."/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BancoIntegro}" Value="False">
                                            <Setter Property="Text" Value="Foram encontrados problemas no banco de dados. Considere restaurar um backup."/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="TAMANHO DO BANCO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TamanhoBancoTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                            <TextBlock Text="MEMÓRIA EM USO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MemoriaTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="VERSÃO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding VersaoAppTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="MACROS / USUÁRIOS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="{Binding TotalMacrosHealth, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding TotalUsuariosHealth, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0">
                            <TextBlock Text="ÚLTIMO BACKUP" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding UltimoBackupTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderLightBrush}"
                                Margin="0,12,0,12" Padding="0,12,0,0">
                            <TextBlock Text="Recursos do computador (desta sessão)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CPU" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CpuTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="MEMÓRIA DO COMPUTADOR" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MemoriaSistemaTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="DISCO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DiscoTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Salvar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SalvarConfiguracoesCommand}"
                        Padding="24,0" Height="42" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Salvar configurações" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
