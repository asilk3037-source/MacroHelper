<Window x:Class="MacroHelper.UI.Views.MacroPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" Width="380">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Border Padding="12,9" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource AccentLightBrush}"
                                CornerRadius="5" Padding="8,3">
                            <TextBlock x:Name="TxtGatilho"
                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                        <TextBlock Text=" — selecione" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="ESC para fechar" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Lista -->
            <ListBox x:Name="ListMacros"
                     Background="Transparent" BorderThickness="0"
                     MaxHeight="260"
                     KeyDown="ListMacros_KeyDown"
                     MouseLeftButtonUp="ListMacros_MouseLeftButtonUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Conteudo}" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           MaxHeight="28" TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentLightBrush}"
                                    CornerRadius="4" Padding="6,2"
                                    VerticalAlignment="Top" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Atalho}" FontSize="9"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="14,9"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Footer atalhos de teclado -->
            <Border Padding="12,7" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Orientation="Horizontal" Opacity=".7">
                    <Border Background="{DynamicResource TableHeaderBgBrush}"
                            CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                        <TextBlock Text="↑↓" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock Text="navegar  " FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource TableHeaderBgBrush}"
                            CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                        <TextBlock Text="Enter" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock Text="inserir  " FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource TableHeaderBgBrush}"
                            CornerRadius="3" Padding="5,2" Margin="0,0,4,0">
                        <TextBlock Text="Esc" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <TextBlock Text="fechar" FontSize="9"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
