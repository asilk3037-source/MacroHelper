<Window x:Class="MacroHelper.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SK MacroHelper" Height="540" Width="420" xml:lang="pt-BR"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Border CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <TextBlock Text="SK MacroHelper" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Click="CloseButton_Click"
                            Style="{StaticResource ButtonIconOnly}" Width="28" Height="28">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,36,40,36">

                    <!-- Header compacto -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                        <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="SK" FontSize="15" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MacroHelper" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="by Aline Martins · Silk" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── FORM LOGIN ── -->
                    <StackPanel x:Name="PanelLogin">

                        <TextBlock Text="Entrar na conta" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,24"/>

                        <!-- Erro -->
                        <Border Background="{DynamicResource DangerBgBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Erro}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Erro}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- E-mail -->
                        <TextBlock Text="E-MAIL" FontSize="10" FontWeight="SemiBold"                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource InputStyle}"
                                 Height="40"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <!-- Senha -->
                        <TextBlock Text="SENHA" FontSize="10" FontWeight="SemiBold"                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource InputBgBrush}"
                                Height="40" Margin="0,0,0,24"
                                x:Name="SenhaBorder">
                            <PasswordBox x:Name="TxtSenha"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="13" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="TxtSenha_PasswordChanged"/>
                        </Border>

                        <!-- Botão entrar -->
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding EntrarCommand}"
                                Height="40" FontSize="13" Margin="0,0,0,16">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Entrar"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Carregando}" Value="True">
                                                <Setter Property="Text" Value="Entrando..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Link criar conta -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Não tem conta? "
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Command="{Binding AbrirCriarContaCommand}"
                                    Height="Auto" Width="Auto" Padding="0">
                                <TextBlock Text="Criar conta" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── FORM CRIAR CONTA ── -->
                    <StackPanel x:Name="PanelCriar">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MostrarCriar}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Criar nova conta" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,24"/>

                        <Border Background="{DynamicResource DangerBgBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding ErroCriar, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding ErroCriar}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="NOME COMPLETO" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding NovoNome, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="E-MAIL" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource InputStyle}" Height="40"
                                 Text="{Binding NovoEmail, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14"/>

                        <TextBlock Text="SENHA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource InputBgBrush}"
                                Height="40" Margin="0,0,0,14">
                            <PasswordBox x:Name="TxtNovaSenha" Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="13" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="TxtNovaSenha_PasswordChanged"/>
                        </Border>

                        <TextBlock Text="CONFIRMAR SENHA" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <Border BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Background="{DynamicResource InputBgBrush}"
                                Height="40" Margin="0,0,0,24">
                            <PasswordBox x:Name="TxtConfirmar" Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         FontSize="13" Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         PasswordChanged="TxtConfirmar_PasswordChanged"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                                    Command="{Binding FecharCriarContaCommand}"
                                    Margin="0,0,10,0" Width="100"/>
                            <Button Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding CriarContaCommand}" Width="130">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Criar conta"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CriandoConta}" Value="True">
                                                    <Setter Property="Text" Value="Criando..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
