<UserControl x:Class="MacroHelper.UI.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Modal formulário -->
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MostrarFormulario}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#80000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="440" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel Margin="28,24">
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding FormTitulo}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                Command="{Binding CancelarFormCommand}" Width="28" Height="28">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding FormErro, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding FormErro}"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                    </Border>

                    <TextBlock Text="NOME *" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="42"
                             Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="ÍCONE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <Border Width="40" Height="40" CornerRadius="9" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentLightBrush}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding FormIcone}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding IconesDisponiveis}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="38" Height="38" Margin="0,0,8,8"
                                        Command="{Binding DataContext.SelecionarIconeCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="1" CornerRadius="8">
                                                            <TextBlock Text="{Binding}" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="15"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="COR (hex)" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,8,0">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource AccentColor}"/>
                            </Border.Background>
                        </Border>
                        <TextBox Grid.Column="1" Style="{StaticResource InputStyle}" Height="42"
                                 Text="{Binding FormCor, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="CATEGORIA PAI (opcional)" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding CategoriasRaiz}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding FormPaiId}"
                              DisplayMemberPath="Nome"
                              Height="42" Margin="0,0,0,24"
                              Background="{DynamicResource InputBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}"
                              FontSize="13"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding CancelarFormCommand}"
                                Margin="0,0,10,0" Width="100"/>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarCategoriaCommand}" Width="130">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Conteúdo principal -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLightBrush}"
                    Padding="28,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Categorias" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Organize suas macros em categorias e subcategorias"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding NovaCategoriaCommand}" Height="38" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Nova Categoria" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Margin="28,12,28,0" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding Mensagem, Converter={StaticResource NullToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"/>
            </Border>

            <ScrollViewer Padding="28,14,28,28">
                <ItemsControl ItemsSource="{Binding Categorias}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <!-- Categoria raiz -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38"
                                                CornerRadius="9" Margin="0,0,12,0"
                                                Background="{DynamicResource AccentLightBrush}">
                                            <TextBlock Text="{Binding Icone}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nome}" FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <Run Text="{Binding Subcategorias.Count, Mode=OneWay}"/>
                                                <Run Text=" subcategorias"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource ButtonIconOnly}"
                                                    ToolTip="Adicionar subcategoria"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.NovaCategoriaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Width="30" Height="30" Margin="0,0,2,0">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource ButtonIconOnly}"
                                                    ToolTip="Editar"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.EditarCategoriaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Width="30" Height="30" Margin="0,0,2,0">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>
                                            <Button ToolTip="Excluir" Cursor="Hand"
                                                    Width="30" Height="30" BorderThickness="0"
                                                    Background="Transparent"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ExcluirCategoriaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" CornerRadius="6"
                                                                Background="{TemplateBinding Background}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background"
                                                                        Value="{DynamicResource DangerBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Subcategorias -->
                                <ItemsControl ItemsSource="{Binding Subcategorias}"
                                              Margin="28,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="14,10" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="&#xE974;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Icone}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Nome}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource ButtonIconOnly}"
                                                                Width="28" Height="28"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.EditarCategoriaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Button>
                                                        <Button Width="28" Height="28" BorderThickness="0"
                                                                Background="Transparent" Cursor="Hand"
                                                                CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.ExcluirCategoriaCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg" CornerRadius="6"
                                                                            Background="{TemplateBinding Background}">
                                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="11"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bg" Property="Background"
                                                                                    Value="{DynamicResource DangerBgBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
