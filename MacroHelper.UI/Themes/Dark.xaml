<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === DARK THEME — "Vapor Chrome" (lavanda/indigo + ciano) === -->
    <Color x:Key="BackgroundColor">#1B1924</Color>
    <Color x:Key="SurfaceColor">#242230</Color>
    <Color x:Key="SurfaceElevatedColor">#2A2837</Color>
    <Color x:Key="BorderColor">#423E4D</Color>
    <Color x:Key="BorderLightColor">#34313F</Color>
    <Color x:Key="TextPrimaryColor">#F1F0F7</Color>
    <Color x:Key="TextSecondaryColor">#B6B3C4</Color>
    <Color x:Key="TextMutedColor">#8C899C</Color>
    <Color x:Key="AccentColor">#A6ABF7</Color>
    <Color x:Key="AccentHoverColor">#8E94F0</Color>
    <Color x:Key="AccentLightColor">#383361</Color>
    <Color x:Key="AccentTextColor">#C7CBFA</Color>
    <Color x:Key="SecondaryColor">#4A4270</Color>
    <Color x:Key="SecondaryForegroundColor">#EDEAF9</Color>
    <Color x:Key="CyanColor">#7FDCEA</Color>
    <Color x:Key="CyanSoftColor">#243C44</Color>
    <Color x:Key="CyanForegroundColor">#DFF8FB</Color>
    <Color x:Key="SuccessColor">#4FC793</Color>
    <Color x:Key="SuccessBgColor">#1E3A2D</Color>
    <Color x:Key="DangerColor">#EB6B54</Color>
    <Color x:Key="DangerBgColor">#3A201C</Color>
    <Color x:Key="WarningColor">#E0B45C</Color>
    <Color x:Key="WarningBgColor">#3A301A</Color>
    <Color x:Key="SidebarColor">#211F2B</Color>
    <Color x:Key="SidebarItemHoverColor">#2C2939</Color>
    <Color x:Key="SidebarItemActiveColor">#38324E</Color>
    <Color x:Key="SidebarTextColor">#D8D5E3</Color>
    <Color x:Key="SidebarTextActiveColor">#F1EEFB</Color>
    <Color x:Key="SidebarMutedColor">#8B879C</Color>
    <Color x:Key="SidebarAccentColor">#A6ABF7</Color>
    <Color x:Key="SidebarBorderColor">#34313F</Color>
    <Color x:Key="InputBgColor">#2A2837</Color>
    <Color x:Key="InputBorderColor">#34313F</Color>
    <Color x:Key="InputFocusBorderColor">#A6ABF7</Color>
    <Color x:Key="TableHeaderBgColor">#211F2B</Color>
    <Color x:Key="TableRowHoverColor">#2E2B3B</Color>
    <Color x:Key="TableRowAltColor">#242230</Color>
    <Color x:Key="ScrollBarColor">#423E4D</Color>
    <Color x:Key="PopupBgColor">#242230</Color>
    <Color x:Key="PopupBorderColor">#A6ABF7</Color>
    <Color x:Key="BadgeBgColor">#383361</Color>
    <Color x:Key="BadgeTextColor">#C7CBFA</Color>
    <Color x:Key="ShadowColor">#60000000</Color>
    <Color x:Key="TitleBarBgColor">#1B1924</Color>

    <!-- === BRUSHES === -->
    <SolidColorBrush x:Key="BackgroundBrush"           Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"              Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"      Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"               Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"          Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"            Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"          Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"          Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush"           Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"            Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"  Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="CyanBrush"                 Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="CyanSoftBrush"             Color="{StaticResource CyanSoftColor}"/>
    <SolidColorBrush x:Key="CyanForegroundBrush"       Color="{StaticResource CyanForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"              Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush"            Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush"               Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush"             Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush"              Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush"            Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"              Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush"     Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush"    Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"          Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush"    Color="{StaticResource SidebarTextActiveColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"         Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush"        Color="{StaticResource SidebarAccentColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"        Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"              Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"          Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush"     Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush"        Color="{StaticResource TableHeaderBgColor}"/>
    <SolidColorBrush x:Key="TableRowHoverBrush"        Color="{StaticResource TableRowHoverColor}"/>
    <SolidColorBrush x:Key="TableRowAltBrush"          Color="{StaticResource TableRowAltColor}"/>
    <SolidColorBrush x:Key="ScrollBarBrush"            Color="{StaticResource ScrollBarColor}"/>
    <SolidColorBrush x:Key="PopupBgBrush"              Color="{StaticResource PopupBgColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush"          Color="{StaticResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="BadgeBgBrush"              Color="{StaticResource BadgeBgColor}"/>
    <SolidColorBrush x:Key="BadgeTextBrush"            Color="{StaticResource BadgeTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBgBrush"           Color="{StaticResource TitleBarBgColor}"/>
</ResourceDictionary>
