<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === LIGHT THEME COLORS === -->
    <Color x:Key="BackgroundColor">#F5F5F0</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FAFAF8</Color>
    <Color x:Key="BorderColor">#E0DED8</Color>
    <Color x:Key="BorderLightColor">#EDECEA</Color>
    <Color x:Key="TextPrimaryColor">#1A1A18</Color>
    <Color x:Key="TextSecondaryColor">#6B6B66</Color>
    <Color x:Key="TextMutedColor">#9B9B96</Color>
    <Color x:Key="AccentColor">#5B4FE8</Color>
    <Color x:Key="AccentHoverColor">#4A3FD4</Color>
    <Color x:Key="AccentLightColor">#EEF0FF</Color>
    <Color x:Key="AccentTextColor">#3B31C0</Color>
    <Color x:Key="SuccessColor">#1A7A4A</Color>
    <Color x:Key="SuccessBgColor">#E8F5EE</Color>
    <Color x:Key="DangerColor">#C0392B</Color>
    <Color x:Key="DangerBgColor">#FDEDEC</Color>
    <Color x:Key="WarningColor">#D4851A</Color>
    <Color x:Key="WarningBgColor">#FEF5E7</Color>
    <Color x:Key="SidebarColor">#F6F5FB</Color>
    <Color x:Key="SidebarItemHoverColor">#ECEAF6</Color>
    <Color x:Key="SidebarItemActiveColor">#E0DEF5</Color>
    <Color x:Key="SidebarTextColor">#6B6A78</Color>
    <Color x:Key="SidebarTextActiveColor">#1A1A18</Color>
    <Color x:Key="SidebarAccentColor">#5B4FE8</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#D0CEC8</Color>
    <Color x:Key="InputFocusBorderColor">#5B4FE8</Color>
    <Color x:Key="TableHeaderBgColor">#F0EEE8</Color>
    <Color x:Key="TableRowHoverColor">#F8F7F3</Color>
    <Color x:Key="TableRowAltColor">#FAFAF8</Color>
    <Color x:Key="ScrollBarColor">#D0CEC8</Color>
    <Color x:Key="PopupBgColor">#FFFFFF</Color>
    <Color x:Key="PopupBorderColor">#5B4FE8</Color>
    <Color x:Key="BadgeBgColor">#EEF0FF</Color>
    <Color x:Key="BadgeTextColor">#3B31C0</Color>
    <Color x:Key="ShadowColor">#20000000</Color>
    <Color x:Key="TitleBarBgColor">#FFFFFF</Color>

    <!-- === BRUSHES === -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="{StaticResource SidebarTextActiveColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource SidebarAccentColor}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush" Color="{StaticResource TableHeaderBgColor}"/>
    <SolidColorBrush x:Key="TableRowHoverBrush" Color="{StaticResource TableRowHoverColor}"/>
    <SolidColorBrush x:Key="TableRowAltBrush" Color="{StaticResource TableRowAltColor}"/>
    <SolidColorBrush x:Key="ScrollBarBrush" Color="{StaticResource ScrollBarColor}"/>
    <SolidColorBrush x:Key="PopupBgBrush" Color="{StaticResource PopupBgColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="BadgeBgBrush" Color="{StaticResource BadgeBgColor}"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBgBrush" Color="{StaticResource TitleBarBgColor}"/>
</ResourceDictionary>
