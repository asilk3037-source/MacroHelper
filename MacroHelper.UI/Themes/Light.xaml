<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === LIGHT THEME — "Vapor Chrome" (lavanda/indigo + ciano) === -->
    <Color x:Key="BackgroundColor">#F7F7FC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#F1F0F8</Color>
    <Color x:Key="BorderColor">#D6D3E2</Color>
    <Color x:Key="BorderLightColor">#E7E5EF</Color>
    <Color x:Key="TextPrimaryColor">#221F30</Color>
    <Color x:Key="TextSecondaryColor">#6B6878</Color>
    <Color x:Key="TextMutedColor">#9795A6</Color>
    <Color x:Key="AccentColor">#818CF8</Color>
    <Color x:Key="AccentHoverColor">#6B74E0</Color>
    <Color x:Key="AccentLightColor">#ECEAFC</Color>
    <Color x:Key="AccentTextColor">#5247D6</Color>
    <Color x:Key="SecondaryColor">#C4B5FD</Color>
    <Color x:Key="SecondaryForegroundColor">#3A2E66</Color>
    <Color x:Key="CyanColor">#67E8F9</Color>
    <Color x:Key="CyanSoftColor">#E3FBFD</Color>
    <Color x:Key="CyanForegroundColor">#1C4E58</Color>
    <Color x:Key="SuccessColor">#2F9C6E</Color>
    <Color x:Key="SuccessBgColor">#E3F7ED</Color>
    <Color x:Key="DangerColor">#E0563F</Color>
    <Color x:Key="DangerBgColor">#FCE8E4</Color>
    <Color x:Key="WarningColor">#C98F2B</Color>
    <Color x:Key="WarningBgColor">#FBF1DE</Color>
    <Color x:Key="SidebarColor">#FAF9FE</Color>
    <Color x:Key="SidebarItemHoverColor">#F1EFFC</Color>
    <Color x:Key="SidebarItemActiveColor">#E7E3FB</Color>
    <Color x:Key="SidebarTextColor">#5B586B</Color>
    <Color x:Key="SidebarTextActiveColor">#2A2640</Color>
    <Color x:Key="SidebarMutedColor">#8B8898</Color>
    <Color x:Key="SidebarAccentColor">#818CF8</Color>
    <Color x:Key="SidebarBorderColor">#E7E5EF</Color>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <Color x:Key="InputBorderColor">#D6D3E2</Color>
    <Color x:Key="InputFocusBorderColor">#818CF8</Color>
    <Color x:Key="TableHeaderBgColor">#F1F0F8</Color>
    <Color x:Key="TableRowHoverColor">#F8F7FD</Color>
    <Color x:Key="TableRowAltColor">#FBFAFE</Color>
    <Color x:Key="ScrollBarColor">#D6D3E2</Color>
    <Color x:Key="PopupBgColor">#FFFFFF</Color>
    <Color x:Key="PopupBorderColor">#818CF8</Color>
    <Color x:Key="BadgeBgColor">#ECEAFC</Color>
    <Color x:Key="BadgeTextColor">#5247D6</Color>
    <Color x:Key="ShadowColor">#20221F30</Color>
    <Color x:Key="TitleBarBgColor">#FFFFFF</Color>

    <!-- === BRUSHES === -->
    <SolidColorBrush x:Key="BackgroundBrush"           Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"              Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"      Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"               Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"          Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"            Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"          Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"          Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush"           Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"            Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"  Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="CyanBrush"                 Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="CyanSoftBrush"             Color="{StaticResource CyanSoftColor}"/>
    <SolidColorBrush x:Key="CyanForegroundBrush"       Color="{StaticResource CyanForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"              Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush"            Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush"               Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush"             Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush"              Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush"            Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"              Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush"     Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush"    Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"          Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush"    Color="{StaticResource SidebarTextActiveColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"         Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush"        Color="{StaticResource SidebarAccentColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"        Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"              Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"          Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush"     Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush"        Color="{StaticResource TableHeaderBgColor}"/>
    <SolidColorBrush x:Key="TableRowHoverBrush"        Color="{StaticResource TableRowHoverColor}"/>
    <SolidColorBrush x:Key="TableRowAltBrush"          Color="{StaticResource TableRowAltColor}"/>
    <SolidColorBrush x:Key="ScrollBarBrush"            Color="{StaticResource ScrollBarColor}"/>
    <SolidColorBrush x:Key="PopupBgBrush"              Color="{StaticResource PopupBgColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush"          Color="{StaticResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="BadgeBgBrush"              Color="{StaticResource BadgeBgColor}"/>
    <SolidColorBrush x:Key="BadgeTextBrush"            Color="{StaticResource BadgeTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBgBrush"           Color="{StaticResource TitleBarBgColor}"/>
</ResourceDictionary>
